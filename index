<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ingrid Eberspächer Stiftung</title>
<meta name="description" content="Ingrid Eberspächer – Arbeiten auf Papier. Website der Ingrid Eberspächer Stiftung mit Werk, Vita und Ausstellungen.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600&display=swap">
<style>
:root{
  --paper:#F6F4EF; --ink:#1A1A18; --text-2:#3F3C36; --muted:#5E5A52; --line:#DAD5CA;
  --accent:#8E3320; --band:#1A1A18; --band-text:#F6F4EF; --band-muted:#BDB6A8; --band-body:#D9D3C7; --band-line:#5E5A52;
  --serif:'Instrument Serif',Georgia,serif; --sans:'Hanken Grotesk',system-ui,sans-serif;
  --pad:clamp(16px,5.5vw,80px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#141412; --ink:#EDEAE3; --text-2:#C9C4B8; --muted:#A39D90; --line:#34322D;
    --accent:#E0876E; --band:#EDEAE3; --band-text:#141412; --band-muted:#5E5A52; --band-body:#3F3C36; --band-line:#BDB6A8;
  }
}
:root[data-theme="dark"]{
  --paper:#141412; --ink:#EDEAE3; --text-2:#C9C4B8; --muted:#A39D90; --line:#34322D;
  --accent:#E0876E; --band:#EDEAE3; --band-text:#141412; --band-muted:#5E5A52; --band-body:#3F3C36; --band-line:#BDB6A8;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;line-height:1.5}
img{max-width:100%;height:auto;display:block}
.hero img{width:100%}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.wrap{max-width:1440px;margin:0 auto;padding:0 var(--pad)}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px}
.eyebrow{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.h2{margin:0;font-family:var(--serif);font-weight:400;font-size:clamp(44px,5.5vw,72px);line-height:1}
.sec-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;border-top:1px solid var(--ink);padding-top:20px;margin-bottom:48px;flex-wrap:wrap}
section{scroll-margin-top:96px}

/* Header */
header{position:sticky;top:0;z-index:10;background:var(--paper);border-bottom:1px solid var(--line)}
.hd{height:88px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;flex-direction:column;gap:2px}
.brand b{font-family:var(--serif);font-weight:400;font-size:28px;line-height:1}
.brand span{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
nav ul{list-style:none;margin:0;padding:0;display:flex;gap:36px;font-size:14px}
nav a{display:block;padding:12px 0}
.menu-btn{display:none;background:none;border:0;color:var(--ink);width:44px;height:44px;padding:10px;cursor:pointer}
@media (max-width:820px){
  .hd{height:72px}
  .brand b{font-size:24px}
  .menu-btn{display:block}
  nav{position:absolute;left:0;right:0;top:72px;background:var(--paper);border-bottom:1px solid var(--line);display:none}
  nav.open{display:block}
  nav ul{flex-direction:column;gap:0;padding:8px var(--pad) 20px}
  nav a{padding:14px 0;font-size:18px;border-bottom:1px solid var(--line)}
}

/* Hero */
.hero{padding-top:64px;align-items:end}
.hero figure{grid-column:span 9;margin:0}
.hero .cap{grid-column:span 3;font-size:13px;color:var(--text-2);display:flex;flex-direction:column;gap:4px}
.cap .t{font-family:var(--serif);font-style:italic;font-size:22px;color:var(--ink)}
.intro{padding-top:120px}
.intro .eyebrow{grid-column:span 3;color:var(--accent);padding-top:14px}
.intro p{grid-column:span 8;margin:0;font-family:var(--serif);font-size:clamp(28px,3.1vw,44px);line-height:1.18}

/* Werk */
#werk{padding-top:150px}
.works{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:64px 24px;align-items:end}
.work{margin:0;display:flex;flex-direction:column;gap:14px}
.work button{all:unset;cursor:zoom-in;display:block}
.work img{width:100%;height:320px;object-fit:contain;object-position:left bottom}
.work.wide{grid-column:span 2}
.work.wide img{height:480px}
.work.low img{height:220px}
.work figcaption{font-size:13px;color:var(--text-2);display:flex;flex-direction:column;gap:2px}
.work figcaption .t{font-family:var(--serif);font-style:italic;font-size:20px;color:var(--ink)}

/* Stiftung */
#stiftung{margin-top:150px;background:var(--band);color:var(--band-text);padding:110px 0}
#stiftung .sec-head{border-color:var(--band-line)}
#stiftung .eyebrow{color:var(--band-muted)}
.st-lead{grid-column:span 7;margin:0;font-family:var(--serif);font-size:clamp(26px,2.6vw,36px);line-height:1.25}
.st-pillars{grid-column:9 / span 4;display:flex;flex-direction:column;gap:28px;font-size:15px;color:var(--band-body)}
.st-pillars div{display:flex;flex-direction:column;gap:6px}
.st-pillars .eyebrow{letter-spacing:.16em}
.st-cta{display:flex;gap:16px;flex-wrap:wrap;margin-top:56px}
.btn{height:52px;padding:0 28px;display:inline-flex;align-items:center;font-size:14px;font-weight:500}
.btn.solid{background:var(--band-text);color:var(--band)}
.btn.ghost{border:1px solid var(--band-muted);color:var(--band-text)}
.btn:hover{opacity:.85;color:inherit}
.btn.solid:hover{color:var(--band)}

/* Vita */
#vita{padding-top:150px}
.vita-img{grid-column:span 3;display:flex;flex-direction:column;gap:12px}
.vita-img img{width:100%;aspect-ratio:1;object-fit:cover;filter:grayscale(1)}
.vita-img span{font-size:13px;color:var(--muted)}
dl{grid-column:5 / span 8;margin:0;display:grid;grid-template-columns:140px minmax(0,1fr);font-size:17px}
dt,dd{margin:0;padding:16px 0;border-bottom:1px solid var(--line)}
dt{color:var(--muted)}

/* Ausstellungen */
#ausstellungen{padding-top:150px}
.ex{grid-column:span 6;font-size:16px}
.ex div{display:grid;grid-template-columns:88px minmax(0,1fr);padding:14px 0;border-bottom:1px solid var(--line)}
.ex div span:first-child{color:var(--accent)}

/* Footer */
footer{margin-top:150px;border-top:1px solid var(--ink);padding:80px 0 48px}
.ct-l{grid-column:span 6;display:flex;flex-direction:column;gap:20px}
.ct-l .h2{font-size:clamp(40px,4.2vw,56px)}
.ct-l p{margin:0;font-size:16px;color:var(--text-2);max-width:460px}
.ct-r{grid-column:8 / span 5;display:flex;flex-direction:column;gap:4px;font-size:16px;padding-top:12px}
.ct-r a{margin-top:12px;border-bottom:1px solid currentColor;align-self:flex-start}
.legal{grid-column:span 12;margin-top:80px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:20px}
.legal div{display:flex;gap:28px}

/* Intro */
.intro-screen{position:fixed;inset:0;z-index:100;background:#0B0B0A;color:#F6F4EF;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;cursor:pointer;
  animation:introOut 1.6s ease-in-out 3s forwards}
.intro-screen .in{display:flex;flex-direction:column;align-items:center;gap:18px;opacity:0;animation:introText 1.8s ease-out .4s forwards}
.intro-screen b{font-family:var(--serif);font-weight:400;font-size:clamp(44px,7vw,96px);line-height:1;letter-spacing:-.01em}
.intro-screen span{font-size:clamp(11px,1.1vw,14px);letter-spacing:.42em;text-transform:uppercase;color:#BDB6A8;padding-left:.42em}
.intro-screen i{display:block;width:0;height:1px;background:#8A8477;animation:introLine 1.4s ease-out 1s forwards}
.intro-screen.skip{animation:introOut .6s ease-in-out forwards}
@keyframes introText{from{opacity:0;transform:translateY(10px);filter:blur(4px)}to{opacity:1;transform:none;filter:none}}
@keyframes introLine{to{width:72px}}
@keyframes introOut{0%{opacity:1;visibility:visible}100%{opacity:0;visibility:hidden}}
body.intro-on main,body.intro-on header,body.intro-on footer{animation:pageIn 2.2s ease-out 3s both}
@keyframes pageIn{from{opacity:.0;transform:scale(1.015)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  .intro-screen{animation-duration:.01s;animation-delay:1.2s}
  .intro-screen .in,.intro-screen i{animation-duration:.01s;animation-delay:0s}
  body.intro-on main,body.intro-on header,body.intro-on footer{animation:none}
}

/* Lightbox */
dialog{border:0;padding:0;background:transparent;max-width:none;max-height:none;width:100vw;height:100vh;margin:0}
dialog::backdrop{background:rgba(12,12,11,.94)}
.lb{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:56px 16px 24px}
.lb img{max-width:min(1400px,100%);max-height:calc(100vh - 140px);object-fit:contain}
.lb p{margin:0;color:#D9D3C7;font-size:14px;text-align:center}
.lb-close{position:absolute;top:12px;right:12px;width:44px;height:44px;background:none;border:0;color:#F6F4EF;cursor:pointer;padding:10px}

/* Responsive */
@media (max-width:1000px){
  .hero figure,.hero .cap,.intro .eyebrow,.intro p,.st-lead,.st-pillars,.vita-img,dl,.ex,.ct-l,.ct-r{grid-column:1 / -1}
  .hero .cap{margin-top:16px}
  .intro{padding-top:80px}.intro p{margin-top:16px}
  .st-pillars{margin-top:40px}
  .vita-img{max-width:320px;margin-bottom:40px}
  .ct-r{margin-top:32px}
  .works{grid-template-columns:repeat(2,minmax(0,1fr))}
  .work.wide{grid-column:1 / -1}
}
@media (max-width:640px){
  .hero{padding-top:32px}
  #werk,#vita,#ausstellungen{padding-top:96px}
  #stiftung,footer{margin-top:96px}
  #stiftung{padding:72px 0}
  .works{grid-template-columns:1fr;gap:48px}
  .work img,.work.wide img,.work.low img{height:auto;max-height:70vh}
  dl{grid-template-columns:96px minmax(0,1fr);font-size:16px}
  .ex div{grid-template-columns:64px minmax(0,1fr)}
  .legal{flex-direction:column}
}
</style>
</head>
